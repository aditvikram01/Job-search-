# Copy to .env.local for local dev. In production set these in Vercel →
# Project → Settings → Environment Variables. Never commit real values.

# --- Phase 0 (needed now) ---
DATABASE_URL=              # Neon connection string (pooled), includes ?sslmode=require
AUTH_SECRET=               # openssl rand -base64 32
AUTH_GOOGLE_ID=            # Google Cloud OAuth client ID
AUTH_GOOGLE_SECRET=        # Google Cloud OAuth client secret
ALLOWED_EMAILS=            # comma-separated: Aditya's and Rasleen's Google login emails
TOKEN_ENCRYPTION_KEY=      # openssl rand -base64 32

# --- Later phases (leave empty for now) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL_DRAFT=
LLM_MODEL_FAST=
LLM_MONTHLY_BUDGET_USD=5
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
JINA_API_KEY=
HUNTER_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
BLOB_READ_WRITE_TOKEN=
